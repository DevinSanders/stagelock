{
  "name": "@videocontroller/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-camera preview, NDI re-broadcast, and AI auto-tracking PTZ studio controller",
  "author": "VideoController Contributors",
  "homepage": "https://github.com/videocontroller/videocontroller",
  "license": "Apache-2.0 OR MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "package:win": "tauri build --bundles nsis,msi",
    "package:mac": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage,deb",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
