{
  "name": "@stagelock/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "StageLock — AI PTZ Tracking & Broadcast Studio",
  "author": "Devin Sanders",
  "homepage": "https://github.com/DevinSanders/stagelock",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "package:win": "tauri build --bundles nsis,msi",
    "package:mac": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage,deb",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
