{
  "name": "stagelock-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev:ui": "pnpm --filter @stagelock/desktop dev",
    "build:ui": "pnpm --filter @stagelock/desktop build",
    "test:ui": "pnpm --filter @stagelock/desktop test",
    "test:ui:coverage": "pnpm --filter @stagelock/desktop test:coverage",
    "package:win": "pnpm --filter @stagelock/desktop package:win",
    "package:mac": "pnpm --filter @stagelock/desktop package:mac",
    "package:linux": "pnpm --filter @stagelock/desktop package:linux",
    "typecheck": "pnpm -r typecheck"
  }
}
