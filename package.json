{
  "name": "video-controller-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev:ui": "pnpm --filter @videocontroller/desktop dev",
    "build:ui": "pnpm --filter @videocontroller/desktop build",
    "test:ui": "pnpm --filter @videocontroller/desktop test",
    "test:ui:coverage": "pnpm --filter @videocontroller/desktop test:coverage",
    "package:win": "pnpm --filter @videocontroller/desktop package:win",
    "package:mac": "pnpm --filter @videocontroller/desktop package:mac",
    "package:linux": "pnpm --filter @videocontroller/desktop package:linux",
    "typecheck": "pnpm -r typecheck"
  }
}
